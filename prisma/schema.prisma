generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  currency  String   @default("MXN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses       Expense[]
  monthlyBudgets MonthlyBudget[]

  @@map("users")
}

model Expense {
  id          String          @id @default(cuid())
  description String
  amount      Float
  category    ExpenseCategory
  type        ExpenseType
  date        DateTime        @default(now())
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("expenses")
}

model MonthlyBudget {
  id        String   @id @default(cuid())
  month     Int
  year      Int
  income    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, year])
  @@map("monthly_budgets")
}

enum ExpenseCategory {
  FOOD
  TRANSPORT
  HOUSING
  HEALTH
  ENTERTAINMENT
  EDUCATION
  CLOTHING
  SAVINGS
  DEBT
  OTHER
}

enum ExpenseType {
  NECESSARY
  UNNECESSARY
  RISK
}
